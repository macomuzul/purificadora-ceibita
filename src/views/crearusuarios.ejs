<!DOCTYPE html>
<html>
<head>
  <title>Crear usuarios</title>
  <%- include("layouts/global") %>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
  <%- include('layouts/toastrfont') %>
  <script defer src="/botontitulo1.js"></script>
  <script defer src="/botonazul.js"></script>
  <script defer src="/modalAutenticacion.js"></script>
  <script defer src="/dropdownroles.js"></script>
  <script defer src="/prevenirCaracteresInputs.js"></script>
  <script defer src="/crearusuarios.js"></script>
</head>

<body>
  <link rel="stylesheet" href="/crearusuarios.min.css">

  <%- include("layouts/navbar.ejs") %>
    <main>
      <div class="filasuperior">
        <botonazul-flechaizquierda data-url="/empleados/usuarios">Volver al menú de usuarios</botonazul-flechaizquierda>
        <boton-titulo1>Desde aquí puedes crear nuevos usuarios</boton-titulo1>
        <div></div><div></div>
      </div>
      <br>

      <form>
        <i class="fa-sharp fa-solid fa-eye-slash"></i>
        <div class="formulario">
          <div><label for="usuario">Nombre de usuario</label><input class="form-control" type="text" id="usuario"></div>
          <div class="divinput"><input-password id="contraseña">Contraseña</input-password></div>
          <div class="divinput"><input-password id="confirmarContraseña">Confirmar contraseña</input-password></div>
          <div><dropdown-roles></dropdown-roles></div>
          <div><label for="correo">Correo (Opcional)</label><input class="form-control" type="email" id="correo" autocomplete="off" required></div>
        </div>

        <div class="contenedorinferior"><input-azul id="guardar">Crear usuario</input-azul></div>
      </form>
    </main>
    <custom-modal></custom-modal>
</body>
</html>
<!DOCTYPE html>
<html>

<head>
  <title>Análisis de datos</title>
  <%- include("layouts/global") %>
  <link rel="stylesheet" href="/analisis.min.css">

  <% if (datos.length > 0) { %>
  <!-- <script defer src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.9.1/chart.min.js"></script> --> -->
  <script defer src="/confeti.js"></script>
  <!-- <script defer src="/chartjs-3.9.1.js"></script> -->
  <script defer src="/chartjs-4.4.3.js"></script>
  <!-- <script src="https://cdn.jsdelivr.net/npm/chart.js"></script> -->


  <script>
    let datosString = `<%=JSON.stringify(datos)%>`
  </script>
  <script defer src="/podio.js"></script>
  <script defer src="/botonPDF.js"></script>
  <script defer src="/botonExcel.js"></script>
  <script defer src="/acordeon.js"></script>
  <script defer src="/graficos.js"></script>
  <script defer src="/popover.js"></script>
  <script defer src="/checkbox.js"></script>
  <script defer src="/botonazul.js"></script>
  <script defer src="/radiobuttons.js"></script>
  <script defer src="/analisis.js"></script>
  <% } %>

</head>

<body>
  <%- include("layouts/navbar") %>
  <main>
    <% if (datos.length > 0) { %>
    <div id="cargando"><span style="font-size: 40px;">Cargando </span><span class="cajaspinner"><span class="spinner-border text-light" style="width: 40px; height: 40px;"></span></span></div>
    <resumen-datos></resumen-datos>
    <div id="podios"></div>
    <custom-graficos id="chartVendidosAgrupadosPorFecha"></custom-graficos>
    <custom-graficos id="chartIngresosAgrupadosPorFecha"></custom-graficos>
    <custom-graficos id="chartVendidosAgrupadosPorProducto"></custom-graficos>
    <custom-graficos id="chartIngresosAgrupadosPorProducto"></custom-graficos>
    <custom-graficos id="chartVendidosCamionAgrupadosPorFecha"></custom-graficos>
    <custom-graficos id="chartIngresosCamionAgrupadosPorFecha"></custom-graficos>
    <custom-graficos id="chartVendidosAgrupadosPorCamion"></custom-graficos>
    <custom-graficos id="chartIngresosAgrupadosPorCamion"></custom-graficos>
    <% } else { %>
    No se encontró ningún registro que cumpla con los requisitos solicitados
    <% } %>
  </main>

</body>

</html>
<!DOCTYPE html>
<html>
<head>
  <title>Mostrar registros eliminados</title>
  <%- include("layouts/global") %>
  <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.5.0/css/all.css">
  <link rel="stylesheet" href="/registroseliminados.min.css">

  <script>
    let pag = parseInt(`<%= pagina %>`);
    let totalPags = parseInt(`<%= totalPaginas %>`);
  </script>
  <script defer src="/spanFechas.js"></script>
  <script defer src="/tabs.js"></script>
  <script defer src="/botonazul.js"></script>
  <script defer src="/svgeliminar.js"></script>
  <script defer src="/botontitulo2.js"></script>
  <script defer src="/accionesRegistrosEliminados.js"></script>
  <script defer src="/registroseliminados.js"></script>
  <script defer src="/moverRegistro.js"></script>
  <script defer src="/paginacion.js"></script>
</head>

<body>
  <%- include("layouts/navbar") %>
  <button id="back-to-top-btn"><i class="fas fa-angle-double-up"></i></button>
  <main>
    <div class="contenedorsuperior">
      <botonazul-flechaizquierda data-url="/respaldos/registroseliminados">Volver al menú</botonazul-flechaizquierda>
      <boton-titulo2>Restaura o elimina definitivamente las tablas borradas</boton-titulo2>
    </div>

    <div class="contenedoreliminarseleccionados">
      <div class="form-check"><label class="form-check-label"><input class="form-check-input" type="checkbox" id="seleccionarTodos"> Seleccionar todos los registros en la página</label></div>
      <div class="contenedorbotones contenedoreliminar eliminartodos">
        <div class="contenedoreliminarinterior"><svg-eliminar blanco></svg-eliminar> <span class="textoeliminar"><div>Eliminar todos los</div><div>registros seleccionados</div></span></div>
      </div>
    </div>
    <%_ datostablas.forEach((reg,i)=> { let {registro, borradoEl} = reg; _%>
    <hr>
    <article name="<%=reg._id%>">
      <contenedor-acciones></contenedor-acciones>
      <h2 class="fechaMover">Fecha del registro: <span-fechas data-fecha="<%=registro._id%>" data-sinhora="true"></span-fechas></h2>
      <custom-tabs>
        <%_ let tablas = registro.tablas _%>
        <div class="tabs"><% tablas.forEach((_, j) => {%><tab-label>Camión <%= (j+1) %></tab-label><% }) %></div>
        <div class="content"><% tablas.forEach((tabla, j) => {%><tab-content hidden><%- include("layouts/tablas", {j, tabla}) %></tab-content><% }); %></div>
      </custom-tabs>
     <div class="tabSeccionAbajo">
      <div class="fechaeliminacion">Se eliminó el <span-fechas data-fecha="<%=borradoEl%>"></span-fechas></div>
      <boton-restaurar></boton-restaurar>
     </div>
    </article>
    <%_ }) _%>
    <hr>
    <div class="contenedorpaginacion"><div class="pagination"><ul></ul></div></div>
  </main>
</body>
</html>
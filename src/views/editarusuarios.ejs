<!DOCTYPE html>
<html>
<head>
  <title>Editar Usuarios</title>
  <%- include("layouts/global") %>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
  <script defer src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/2.1.3/toastr.min.js"></script>
  <script defer src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js"></script>
  <script defer src="/botonazul.js"></script>
  <script defer src="/botontitulo1.js"></script>
  <script defer src="/modalAutenticacion.js"></script>
  <script defer src="/dropdownroles.js"></script>
  <script defer src="/prevenirCaracteresInputs.js"></script>
  <script defer src="/editarusuarios.js"></script>
</head>

<body>
  <link rel="stylesheet" href="/crearusuarios.min.css" />
  <link rel="stylesheet" href="/editarusuarios.min.css" />

  <%- include("layouts/navbar.ejs") %>
    <main>
      <div class="filasuperior">
        <botonazul-flechaizquierda data-url="/empleados/usuarios">Volver al menú de usuarios</botonazul-flechaizquierda>
        <boton-titulo1>Desde aquí puedes editar los usuarios</boton-titulo1>
      </div>
      <div class="usuarioSeleccionado">Usuario Seleccionado: <%=usuario%></div>
      <form>
        <hr>
        <div class="formulario">
          <div class="fila">
            <div class="divinput"><label>Nombre <input class="form-control" type="text" id="usuario" autocomplete="off" value="<%=usuario%>"></label></div>
            <input-azul class="botonenviar" id="cambiarUsuario">Cambiar nombre</input-azul>
          </div>
          <hr>
          <div class="fila">
            <div class="formcontraseña">
              <div class="divinput"><input-password id="contraseña">Contraseña</input-password></div>
              <div class="divinput"><input-password id="confirmarContraseña">Confirmar contraseña</input-password></div>
            </div>
            <input-azul class="botonenviar" id="cambiarContraseña">Cambiar contraseña</input-azul>
          </div>
          <hr>
          <div class="fila">
            <div class="divrol"><dropdown-roles data-seleccionado="<%=rol%>"></dropdown-roles></div>
            <input-azul class="botonenviar" id="cambiarRol">Cambiar rol</input-azul>
          </div>
          <hr>
          <div class="fila">
            <div class="divinput"><label>Correo <input class="form-control" type="email" id="correo" autocomplete="off" required value="<%=correo%>"></label></div>
            <input-azul class="botonenviar" id="cambiarCorreo">Cambiar correo</input-azul>
          </div>
          <hr>
        </div>
      </form>
    </main>
    <custom-modal></custom-modal>

</body>
</html>
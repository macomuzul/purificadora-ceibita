<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=1200px">
  <title>Ver Usuarios</title>
  <%- include("layouts/global") %>
  <script defer src="/counter.js"></script>
  <script defer src="/modalAutenticacion.js"></script>
  <script defer src="/botontitulo1.js"></script>
  <script defer src="/botonazul.js"></script>
  <script defer src="/svgeliminar.js"></script>
  <script defer src="/verusuarios.js"></script>
  <%- include('layouts/toastrfont') %>
</head>

<body>
  <link rel="stylesheet" href="/verusuarios.min.css">
  <%- include("layouts/navbar") %>

  <main>
    <div class="filasuperior">
    <div></div>
    <boton-titulo1>Desde aquí puedes administrar los usuarios</boton-titulo1>
    <botonazul-flechaderecha data-url="/empleados/usuarios/crear" class="botoncrear">Crear nuevo usuario</botonazul-flechaderecha>
    </div>
    <table>
    <thead>
        <tr>
        <th class="usuario">Usuario</th>
        <th class="contraseña">Contraseña</th>
        <th>Ver contraseña</th>
        <th class="rol">Rol</thc>
        <th class="correo">Correo</thc>
        <th>Editar</th>
        <th>Eliminar</th>
        </tr>
    </thead>
    <tbody>
        <% usuarios.forEach(({usuario, rol, correo}) => { %>
        <tr>
          <td><%=usuario%></td>
          <td>********</td>
          <td>
            <div class="contenedorflex">
              <custom-counter></custom-counter>
              <i class="fa-sharp fa-solid fa-eye" hidden></i>
              <i class="fa-sharp fa-solid fa-eye-slash"></i>
            </div>
          </td>
        <td><%=rol%></td>
        <td><% if(correo){ %> <%=correo%><% } else { %>-<% } %></td>
        <td><svg class="svgeditar" viewBox="0 0 24 24"><path d="M20.548 3.452a1.542 1.542 0 0 1 0 2.182l-7.636 7.636-3.273 1.091 1.091-3.273 7.636-7.636a1.542 1.542 0 0 1 2.182 0zM4 21h15a1 1 0 0 0 1-1v-8a1 1 0 0 0-2 0v7H5V6h7a1 1 0 0 0 0-2H4a1 1 0 0 0-1 1v15a1 1 0 0 0 1 1z"/></svg></td>
        <td><svg-eliminar></svg-eliminar></td>
        </tr>
      <% }) %>
    </tbody>
    </table>

  </main>
  <custom-modal></custom-modal>
</body>
</html>
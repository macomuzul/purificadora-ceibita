<!DOCTYPE html>
<html>
<head>
  <title>Crear Plantillas</title>
  <%- include("layouts/global") %>
  <link rel="stylesheet" href="/comunCrearYEditarPlantillas.min.css">
  <link rel="stylesheet" href="/crearplantillas.min.css">

  <script defer src="https://code.jquery.com/ui/1.13.1/jquery-ui.js"></script>
  <script defer src="//cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script defer src="/tecladoTabla.js"></script>
  <script defer src="/switchSortableTabla.js"></script>
  <script defer src="/botonazul.js"></script>
  <script defer src="/botontitulo1.js"></script>
  <script defer src="/crearplantillas.js"></script>
  <script defer src="/comunCrearYEditarPlantillas.js"></script>
  <script defer src="/dropdown.js"></script>
</head>

<body>
  <%- include("layouts/navbar") %>
    <main>
      <section>
      <div class="filasuperior">
        <div class="volver"><botonazul-flechaizquierda data-url="/plantillas" class="botoncrear">Volver al menú principal</botonazul-flechaizquierda></div>
        <boton-titulo1>Desde aquí puedes crear tus plantillas</boton-titulo1>
        <div></div>
      </div>
      <div class="contenedorsuperior">
        <label for="selector" class="label">Crear plantilla en base a otra plantilla</label>
        <custom-dropdown data-idmenu="" data-idseleccionado="seleccionado" data-textopordefecto="Selecciona una plantilla aquí (opcional)">
          <% plantillas.forEach(plantilla => { %>
            <li><%= plantilla.nombre %></li>
          <% }); %>
        </custom-dropdown>
      </div>
      <br>
      <div class="contenedormedio">
        <switch-sortable></switch-sortable>
        <div class="nombreplantilla">
          <label for="nombreplantilla">Nombre de la plantilla:</label>
          <input type="text" id="nombreplantilla"/>
        </div>
        <switch-preguntar></switch-preguntar>
      </div>
      <table>
        <thead>
          <tr><th class="productos">Productos</th><th class="precio">Precio</th><th class="precio">Eliminar</th></tr>
        </thead>
        <tbody>
          <tr><td contenteditable="true"></td><td contenteditable="true"></td><td><button type="button" class="botoneliminar"><svg class="svgeliminar" width="30" height="30" fill="red" class="bi bi-trash" viewBox="0 0 16 16"><path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6z" /><path fill-rule="evenodd" d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1v1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4H4.118zM2.5 3V2h11v1h-11z" /></svg></button></td></tr>
        </tbody>
      </table>

      <div class="contenedorinferior">
        <input-azul id="añadirproducto">Añadir producto</input-azul>
        <input-azul id="guardar">Crear plantilla</input-azul>
      </div>
    </section>
    </main>
</body>
</html>
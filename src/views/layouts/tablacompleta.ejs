<% let cantidadViajes = (tabla?.productos[0].viajes.length ?? 1); if (cantidadViajes !== 1) cantidadViajes /= 2 %>
<%_ let normalizar = x => x.toFixed(2).replace(/[.,]00$/, "") _%>
<table class="tablacompleta">
    <thead>
      <col><col>
      <colgroup class="pintarcolumnas"><%_ for(a = 0; a < cantidadViajes; a++) { _%> <col span="2"><% }%></colgroup>
      <col><col>
      <tr>
        <th rowspan="2" class="prod">Productos</th>
        <th rowspan="2" class="tr">Precio</th>
        <% for(a = 0; a < cantidadViajes; a++) { %><th colspan="2" class="borrarcolumnas">Viaje No. <%= (a+1) %></th> <% }%>
        <th rowspan="2" class="tr columnaVendidos">Vendidos</th>
        <th rowspan="2" class="tr">Ingresos</th>
      </tr>
      <tr class="saleYEntra"><% for(a = 0; a < cantidadViajes; a++) { %><th>Sale</th><th>Entra</th><% }%></tr>
    </thead>
    <tbody class="cuerpo">
      <%_ if (tabla) { _%>
        <%_ for(k=0; k < tabla.productos.length; k++) { _%>
        <%_ let producto = tabla.productos[k] _%>
        <tr>
          <td><%= producto.nombre %></td>
          <td><%= normalizar(producto.precio) %></td>
          <% producto.viajes.forEach(x => { %> <td><%= x %></td> <% }) %>
          <td><%= producto.vendidos %></td>
          <td><%= normalizar(producto.ingresos) %></td>
        </tr>
        <%_ } _%>
      <%_ } else { _%>
        <% plantillaDefault.productos.forEach(x => { %><tr><td><%= x.producto %></td><td><%= normalizar(x.precio) %></td><td></td><td></td><td></td><td></td></tr><% }) %>
      <%_ } _%>
    </tbody>
    <tfoot>
      <tr>
        <%_ if (tabla) { _%>
          <td colspan="<%= cantidadViajes * 2 + 2 %>">Total:</td><td><%= tabla.totalvendidos %></td><td><%= normalizar(tabla.totalingresos) %></td>
        <%_ } else { _%>
          <td colspan="4">Total:</td><td></td><td></td>
        <%_ } _%>
      </tr>
    </tfoot>
  </table>
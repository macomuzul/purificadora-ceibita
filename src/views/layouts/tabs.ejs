<style>
.tabs {
  display: flex;
  flex-wrap: wrap;
  font-family: sans-serif;
  margin-top: 10px;
  justify-content: center;
  margin-bottom: 0;
}

.tabLabel, .añadirCamion {
  padding: 12px 20px;
